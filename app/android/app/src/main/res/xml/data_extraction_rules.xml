<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
    </device-transfer>
</data-extraction-rules>
